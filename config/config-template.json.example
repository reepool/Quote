        },
        "acquisition": {
          "source_routes": ["cninfo", "sse", "szse", "bse"],
          "normalized_categories": ["annual_report"],
          "download_concurrency": 2,
          "per_source_concurrency": 1,
          "max_task_download_bytes": 53687091200,
          "max_task_planned_bytes": 53687091200,
          "max_task_actual_bytes": 53687091200,
          "source_requests_per_minute": {
            "cninfo": 30,
            "sse": 20,
            "szse": 20,
            "bse": 20
          }
        },
        "discovery": {
          "overlap_days": 3,
          "initial_lookback_days": 180,
          "reconciliation_lookback_days": 400,
          "reconciliation_cohort_size": 200,
          "reconciliation_max_cycle_days": 30,
          "missing_repair_cohort_size": 100,
          "max_pages": 20,
          "page_size": 30,
          "max_requests": 300,
          "max_windows": 64,
          "max_instruments": 200,
          "max_elapsed_seconds": 1800,
          "targeted_repair_lookback_years": 5,
          "targeted_repair_max_requests": 50,
          "targeted_repair_max_instruments": 100,
          "targeted_repair_max_elapsed_seconds": 600,
          "provider_coverage_start_year": 2000
        },
        "storage": {
          "warning_utilization": 0.8,
          "hard_stop_utilization": 0.9,
          "free_space_reserve_bytes": 107374182400,
          "max_attachment_bytes": 209715200,
          "max_attachment_planned_bytes": 209715200,
          "max_attachment_actual_bytes": 209715200,
          "unknown_length_reservation_bytes": 67108864,
          "part_max_age_seconds": 3600,
          "part_max_bytes": 10737418240,
          "part_warning_age_seconds": 1800,
          "part_warning_bytes": 5368709120,
          "part_safety_grace_seconds": 300,
          "quarantine_warning_age_seconds": 604800,
          "quarantine_hard_age_seconds": 2592000,
          "quarantine_warning_bytes": 1073741824,
          "quarantine_hard_bytes": 10737418240,
          "quarantine_cleanup_policy": "operator_audited_only",
          "predecessor_cleanup_warning_age_seconds": 604800,
          "predecessor_cleanup_hard_age_seconds": 2592000,
          "candidate_verification_max_bytes": 10737418240,
          "unprotected_write_reservation_bytes": 67108864
        },
        "retry": {
          "max_attempts": 4,
          "initial_backoff_seconds": 60,
          "max_backoff_seconds": 3600,
          "lease_seconds": 900,
          "heartbeat_seconds": 60,
          "lease_safety_grace_seconds": 30
        },
        "backup": {
          "enabled": false,
          "scheduled_enabled": false,
          "mount_root": "data/QuoteBak",
