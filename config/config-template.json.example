          "warning_utilization": 0.8,
          "hard_stop_utilization": 0.9,
          "free_space_reserve_bytes": 53687091200,
          "freshness_hours": 48,
          "max_unprotected_bytes": 10737418240,
          "max_unprotected_age_seconds": 259200,
          "unprotected_accumulation_origin": "first_unprotected_at",
          "reset_on_verified_backup": true,
          "unblock_requires_verified_backup": true,
          "recovery_journal_retention_policy": "append_only_no_automatic_gc.v1",
          "recovery_journal_integrity_policy": "sha256_chain_with_watermarks.v1"
        },
        "capacity_override": {
          "enabled": false,
