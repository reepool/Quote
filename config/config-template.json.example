          "expected_mount_source": "192.168.188.88:/volume2/Announcement"
        },
        "legacy_inventory": {
          "registry_version": "legacy_annual_report_roots.v1",
          "path_template_version": "legacy_annual_report_paths.v1",
          "exclusion_policy_version": "legacy_annual_report_exclusions.v1",
          "roots": {
            "business_profile": {
              "base_root": "data/filings/business_profile",
              "path_template": "business_profile/{fiscal_year}/{exchange}/"
            },
            "broker_risk_control": {
              "base_root": "data/filings/financial_statements/broker_risk_control",
              "path_template": "broker_risk_control/{exchange}/{symbol}/"
            }
          },
          "exclusions": {
            "allowed_document_families": ["annual_report"],
            "business_profile_subtrees": ["derived"],
            "broker_document_families": ["semiannual_report"]
