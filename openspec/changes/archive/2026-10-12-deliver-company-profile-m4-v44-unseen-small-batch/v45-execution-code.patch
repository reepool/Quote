+def _native_actor_definitions(text: str) -> list[tuple[str, str, str]]:
+    """Read all aliases and a wrapped current legal name before former names."""
+    text = text.replace("\r", "")
+    definitions = []
+    for m in re.finditer(
+        r"(?m)^\s*(?P<aliases>[\u4e00-\u9fffA-Za-z、]{2,50})[ \t]+指[ \t]*\n?[ \t]*"
+        r"(?P<name>[\u4e00-\u9fffA-Za-z（）()]{2,60}?公司)",
+        text,
+    ):
+        for alias in m["aliases"].split("、"):
+            definitions.append((alias, m["name"], m.group()))
+    known = {alias for alias, _, _ in definitions}
+    for m in re.finditer(r"(?m)^\s*(.+?)\s+指\s+([^\n]+)", text):
+        for alias in m[1].split("、"):
+            alias = re.sub(r"\s+", "", alias)
+            if alias not in known:
+                definitions.append((alias, m[2].strip(), m.group()))
+                known.add(alias)
+    return definitions
+
