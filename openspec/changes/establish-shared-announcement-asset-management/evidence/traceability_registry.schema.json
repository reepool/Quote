{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quote:announcement-assets:traceability-registry:v1",
  "title": "Announcement asset normative traceability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_name",
    "id_namespace",
    "requirements_document",
    "requirements_document_sha256",
    "task_catalog_sha256",
    "normative_source_sha256",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "announcement_asset_traceability_registry.v1"
    },
    "change_name": {
      "const": "establish-shared-announcement-asset-management"
    },
    "id_namespace": {
      "const": "AAM-V1"
    },
    "requirements_document": {
      "const": "docs/development/official_annual_report_asset_management_requirements.md"
    },
    "requirements_document_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "task_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "normative_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "aliases",
        "source_aliases",
        "kind",
        "requirements_sections",
        "spec_path",
        "requirement",
        "scenario",
        "clause_text",
        "clause_sha256",
        "source_key",
        "occurrence",
        "task_ids",
        "owner"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "pattern": "^AAM-V1-[0-9]{4}$"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "kind": {
          "enum": ["scenario", "shall"]
        },
        "requirements_sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          }
        },
        "spec_path": {
          "type": "string",
          "pattern": "^openspec/changes/establish-shared-announcement-asset-management/specs/.+/spec\\.md$"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": ["string", "null"]
        },
        "clause_text": {
          "type": "string",
          "minLength": 1
        },
        "clause_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_key": {
          "$ref": "#/$defs/sha256"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
